      "code": "65 # \u8fd4\u56de\uff1a\u6210\u529f\u8fd4\u56de PFX \u5b57\u8282\u6d41\uff08\u4f9b\u524d\u7aef\u4e0b\u8f7d\u540e\u5bfc\u5165\u6d4f\u89c8\u5668\uff09\uff1b\u4efb\u4e00\u6b65 openssl \u5931\u8d25\u8fd4\u56de None\n66 def generate_client_cert(\n67     username: str,\n68     ca_cert_path: str,\n69     ca_key_path: str,\n70     client_ext_cnf_path: str,\n71     days: int = 365,\n72     password: str = '123456',\n73     role: str = 'user',\n74 ) -> Optional[bytes]:\n75     # \u5168\u90e8\u4e2d\u95f4\u4ea7\u7269\uff08\u79c1\u94a5 / CSR / \u8bc1\u4e66 / PFX\uff09\u90fd\u5728\u4e34\u65f6\u76ee\u5f55\u4e2d\u751f\u6210\uff0c\n76     # \u51fd\u6570\u9000\u51fa\u540e\u4e34\u65f6\u76ee\u5f55\u81ea\u52a8\u6e05\u7406\uff0c\u5ba2\u6237\u7aef\u8bc1\u4e66\u53ea\u5728\u5185\u5b58\u4e0e\u6700\u7ec8\u8fd4\u56de\u7684 PFX \u5b57\u8282\u6d41\u4e2d\u5b58\u5728\n77     with tempfile.TemporaryDirectory() as tmpdir:\n78         # \u2014\u2014 \u9632\u5fa1\u6027\u6821\u9a8c\uff08\u7b2c\u4e00\u9053\uff09\uff1ausername \u4f1a\u62fc\u8fdb -subj \u8bc1\u4e66\u4e3b\u4f53\u4e0e\u4e34\u65f6\u6587\u4ef6\u540d\uff0c\n79         #    \u8fd9\u91cc\u505a\u767d\u540d\u5355\u68c0\u67e5\uff0c\u675c\u7edd DN \u6ce8\u5165\uff08\u5982\u542b / \u4f1a\u6539\u53d8 DN \u7ed3\u6784\uff09\n80         #    \u4e0e\u8def\u5f84\u7a7f\u8d8a\uff08\u5982\u542b ..\\ \u4f1a\u8df3\u51fa\u4e34\u65f6\u76ee\u5f55\uff09\u3002\n81         #    \u8c03\u7528\u65b9\uff08register.py\uff09\u867d\u7136\u4e5f\u6821\u9a8c\uff0c\u4f46\u672c\u51fd\u6570\u662f\u516c\u5171\u5165\u53e3\uff0c\u9700\u81ea\u884c\u515c\u5e95\u3002\n82         if not isinstance(username, str) or not re.match(r'^[A-Za-z0-9_]+$', username):\n83             raise ValueError(f'\u7528\u6237\u540d\u542b\u975e\u6cd5\u5b57\u7b26: {username!r}')\n84 \n85         # \u2014\u2014 \u53e3\u4ee4\u6821\u9a8c\uff08\u7b2c\u4e00\u9053\uff09\uff1a\u975e\u7a7a\u3001\u2264128 \u5b57\u7b26\u3001\u4e0d\u4ee5 - \u5f00\u5934\u3001\u4ec5\u5b89\u5168\u5b57\u7b26\n86         validate_secret(password, 'PFX \u53e3\u4ee4')\n87 \n88         # \u6309\u89d2\u8272\u91cd\u547d\u540d\u7528\u6237\u540d\uff08user_\u5f20\u4e09 / seller_\u674e\u56db\uff09\uff0c\u4f7f\u8bc1\u4e66 CN \u80fd\u533a\u5206\u7528\u6237\u4e0e\u5546\u5bb6\uff1b\n89         # \u540e\u7eed\u767b\u5f55\u9a8c\u8bc1\u65f6\u636e\u6b64\u4ece CN \u8fd8\u539f\u51fa\u7eaf\u7528\u6237\u540d\uff08\u89c1 ca_client_crt_yanzheng.py\uff09\n90         if role == 'user':\n91             username = f\"{role}_{username}\"\n92         elif role == 'seller':\n93             username = f\"{role}_{username}\"\n94         else:\n95             raise ValueError(f\"\u6ca1\u6709{role}\u8fd9\u4e2a\u89d2\u8272\")\n96 \n97         # \u5b9a\u4e49\u4e34\u65f6\u6587\u4ef6\u8def\u5f84\n98         client_key_path = os.path.join(tmpdir, f\"{username}.key\")\n99         client_csr_path = os.path.join(tmpdir, f\"{username}.csr\")\n100         client_cert_path = os.path.join(tmpdir, f\"{username}.crt\")\n101         client_pfx_path = os.path.join(tmpdir, f\"{username}.pfx\")\n102         #1.\u751f\u6210\u5ba2\u6237\u7aefSM2\u79c1\u94a5\n103         # \u547d\u4ee4\uff1aopenssl ecparam -name SM2 -genkey -out \u5ba2\u6237\u7aef\u79c1\u94a5\n104         # \u2014\u2014 \u751f\u6210\u56fd\u5bc6 SM2 \u692d\u5706\u66f2\u7ebf\u5bc6\u94a5\u5bf9\uff08\u5ba2\u6237\u7aef\u79c1\u94a5\uff0c\u53ea\u5728\u672c\u51fd\u6570\u5185\u4f7f\u7528\uff0c\u6700\u7ec8\u6253\u8fdb PFX\uff09\n105         try:\n106                 run_openssl(\n107                     ['ecparam', '-name', 'SM2', '-genkey', '-out', client_key_path]\n108                 )\n109 \n110                 #2. \u751f\u6210\u5ba2\u6237\u7aefCSR\n111                 # \u547d\u4ee4\uff1aopenssl req -new \u2014\u2014 \u7528\u79c1\u94a5\u751f\u6210\u8bc1\u4e66\u7b7e\u540d\u8bf7\u6c42(CSR)\uff1a\n112                 # \u5185\u542b\u516c\u94a5\u4e0e\u4e3b\u4f53\u4fe1\u606f(CN=user_\u7528\u6237\u540d\u3001emailAddress=\u2026)\uff0c\u4f46\u4e0d\u542b\u79c1\u94a5\uff0c\n113                 # \u56e0\u6b64\u53ef\u5b89\u5168\u5730\u628a CSR \u4ea4\u7ed9 CA(\u670d\u52a1\u7aef)\u53bb\u7b7e\u53d1\u8bc1\u4e66\n114                 run_openssl([\n115                         'req', '-new', '-key', client_key_path,\n116                         '-out', client_csr_path,\n117                         '-subj', f'/C=CN/ST=Sichuan/L=Chengdu/O=UESTC/CN={username}/emailAddress=zhangsan@uestc.edu.cn'\n118                     ])\n119                 #.4 \u4f7f\u7528\u6839CA\u7b7e\u53d1\u5ba2\u6237\u7aef\u8bc1\u4e66\n120                 # \u547d\u4ee4\uff1aopenssl x509 -req -CA \u6839CA\u8bc1\u4e66 -CAkey \u6839CA\u79c1\u94a5 ...\n121                 # \u2014\u2014 \u5373\u201cCA \u7528\u81ea\u5df1\u79c1\u94a5\u4e3a CSR \u7b7e\u540d\u201d\uff0c\u628a\u8bf7\u6c42\u8f6c\u6362\u6210\u771f\u6b63\u7684 X.509 \u5ba2\u6237\u7aef\u8bc1\u4e66\uff1a\n122                 #   -CAcreateserial \u7ef4\u62a4\u8bc1\u4e66\u5e8f\u5217\u53f7\u6587\u4ef6\uff1b-days \u6307\u5b9a\u6709\u6548\u671f\uff1b\n123                 #   -sm3 \u56fd\u5bc6\u6458\u8981\u7b97\u6cd5\uff1b-extfile/-extensions \u9644\u52a0\u5ba2\u6237\u7aef\u8bc1\u4e66\u6269\u5c55\n124                 #   \uff08\u6765\u81ea client_ext.cnf\uff1a\u5bc6\u94a5\u7528\u9014 / \u8bc1\u4e66\u7c7b\u578b / \u7ea6\u675f\u7b49\uff0c\n125                 #     \u7ea6\u675f\u8be5\u8bc1\u4e66\u53ea\u80fd\u4f5c\u4e3a\u5ba2\u6237\u7aef\u8bc1\u4e66\u4f7f\u7528\uff0c\u4e0d\u80fd\u7528\u4e8e\u7b7e\u53d1\u4e0b\u7ea7\u8bc1\u4e66\uff09\n126                 run_openssl([\n127                     'x509', '-req', '-in', client_csr_path,\n128                     '-CA', ca_cert_path, '-CAkey', ca_key_path,\n129                     '-CAcreateserial', '-out', client_cert_path, '-days', f'{days}',\n130                     '-sm3', '-extfile', client_ext_cnf_path, '-extensions', 'v3_req'\n131                 ])\n132 \n133     #\u6253\u5305\u6210pfx\u683c\u5f0f\n134     # \u547d\u4ee4\uff1aopenssl pkcs12 -export \u2014\u2014 \u628a\u201c\u5ba2\u6237\u7aef\u