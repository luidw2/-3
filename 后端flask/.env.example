# ==========================================================================
# 后端环境变量模板：复制本文件为 .env，再按本机实际情况填写
#   cp .env.example .env
# .env 含本机口令与私钥，不会入库（见 .gitignore）
# ==========================================================================

# ---- Flask ----
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=请替换为随机64位hex

# ---- MySQL（db.py 使用 DB_* 系列变量）----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=请填写本机MySQL密码
DB_NAME=secure_ecommerce
DB_CHARSET=utf8mb4

# ---- JWT（app/utils/auth.py）----
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=请替换为随机64位hex
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=1

# ---- 安全隧道 SM2 密钥（hex，64位私钥 / 128位公钥）----
# 可用 app/utils/SM2.py 的 gmssl_sm2_generate_keypair() 生成；
# 下面是一组可直接用于本地 Demo 的示例密钥，与前端 .env 是同一套，
# 前后端任一侧重新生成后，另一侧必须同步更换。
SM2_FLASK_PUBLIC_KEY=bd7570293539cffcfe6cd42d30a454ccc4553009fdd0053dc8e686b87d42ffefb731c7cedf72feeb9de7890ef16139b51e04dfbf7717c6ae955546c120fb8ccf
SM2_FLASK_PRIVATE_KEY=193e5d4e398f41b936cf341c6aaebf4e9d36ea7905f86a43d0222aa2ba2a3b42
SM2_VUE_PUBLIC_KEY=b5449676be878e4bb92bfeaac198d34e658c785b5b918bf81c25507c006b375968e2a2e4c3e93301691588b0a5394e187997e6b95a42216f9a900bb32e83943b
SM2_VUE_PRIVATE_KEY=d9f459fb33111f1830f95e3069a262687aa65c112f19546f57b7f61844051ef0

# ---- 隧道开关与防重放参数 ----
# TUNNEL_ENABLED=0 时隧道装饰器退化为空，接口回到明文（便于对照抓包）
TUNNEL_ENABLED=1
TUNNEL_TS_WINDOW_MS=300000
TUNNEL_NONCE_TTL_S=600

# ---- 证书目录（config/ca_path.py，默认 app/certs）----
CERTS_DIR=app/certs

# ---- 旧 SM2/支付模块调用的 OpenSSL（非隧道功能，按需填写）----
OPENSSL_PATH=
