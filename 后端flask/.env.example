# Copy to .env and fill local credentials. Never commit .env.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=YOUR_LOCAL_MYSQL_USER
DB_PASSWORD=YOUR_LOCAL_MYSQL_PASSWORD
DB_NAME=perf9_baseline
DB_CHARSET=utf8mb4
OPENSSL_PATH='C:/Program Files/OpenSSL-Win64/bin/openssl.exe'
CERTS_DIR=app/certs
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=7
SM4_KEY=REPLACE_WITH_32_HEX_CHARACTERS
SM2_FLASK_PRIVATE_KEY=REPLACE_WITH_64_HEX_CHARACTERS
SM2_FLASK_PUBLIC_KEY=REPLACE_WITH_128_HEX_CHARACTERS
SM2_VUE_PRIVATE_KEY=REPLACE_WITH_64_HEX_CHARACTERS
SM2_VUE_PUBLIC_KEY=REPLACE_WITH_128_HEX_CHARACTERS
TUNNEL_ENABLED=1
FLASK_HOST=127.0.0.1
FLASK_PORT=5001
FLASK_DEBUG=0
