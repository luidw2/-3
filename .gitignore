# ============================================================
#  Python / Flask 后端
# ============================================================
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
env/

# 运行日志（logging_config.py 自动生成）
logs/
*.log

# 运行时数据库
instance/
*.sqlite3
*.db

# 运行期上传的文件（用户上传内容，不属于源码）
uploads/

# ============================================================
#  Vue 前端
# ============================================================
node_modules/
dist/
dist-ssr/
.vite/
*.local

# ============================================================
#  IDE / 编辑器
# ============================================================
.idea/
.vscode/

# ============================================================
#  敏感文件：绝不入库（本仓库是 PUBLIC）
#  .crt / .csr / *_public.pem 属于公开材料，仍然保留
# ============================================================
.env
.env.*
!.env.example
config.local.py

# 私钥与密钥容器
*.key
*.pfx
*.p12
*_private.pem

# 证书签发过程产生的状态文件
*.srl
